<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Визуальная новелла</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: "Segoe UI", system-ui, sans-serif;
    background: #000;
    user-select: none;
  }

  #game {
    position: relative;
    width: 100vw;
    height: 100vh;
    cursor: pointer;
  }

  /* Фон локации. Замени location1.jpg на своё имя файла */
  #background {
    position: absolute;
    inset: 0;
    background: url("location1.jpg") center/cover no-repeat;
    background-color: #1a1a1a;
  }

  /* Чёрный прямоугольник сверху */
  #dialogue-box {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 1100px;
    min-height: 130px;
    padding: 18px 24px;
    background: rgba(0, 0, 0, 0.88);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    color: #fff;
    font-size: 22px;
    line-height: 1.4;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.6);
    transition: opacity 0.2s ease;
  }

  #speaker {
    color: #ffd166;
    font-weight: 700;
    margin-bottom: 6px;
  }

  #text { white-space: pre-line; }

  #hint {
    position: absolute;
    right: 16px;
    bottom: 8px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    animation: blink 1.4s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 0.3; }
    50%      { opacity: 1; }
  }

  /* Варианты ответа */
  #choices {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .choice {
    padding: 16px 22px;
    background: rgba(0, 0, 0, 0.85);
    border: 2px solid rgba(255, 209, 102, 0.4);
    border-radius: 6px;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, transform 0.1s;
  }

  .choice:hover {
    background: rgba(255, 209, 102, 0.15);
    border-color: #ffd166;
    transform: translateX(4px);
  }

  .hidden { display: none !important; }
</style>
</head>
<body>

<div id="game">
  <div id="background"></div>

  <div id="dialogue-box" class="hidden">
    <div id="speaker"></div>
    <div id="text"></div>
    <div id="hint">▼ пробел / ЛКМ</div>
  </div>

  <div id="choices" class="hidden"></div>
</div>

<script>
// ====== ДАННЫЕ СЦЕНЫ ======
const script = [
  {
    type: "line",
    speaker: "Татьяна Евгеньевна",
    text: "-Ты чего тут ошиваешься! Школа уже как 5 часов закрыта!"
  },
  {
    type: "line",
    speaker: "",
    text: "..."
  },
  {
    type: "choices",
    options: [
      {
        text: "Я случайно заснул в раздевалке, уже иду домой",
        next: "sleep"
      },
      {
        text: "Какая тебе разница, что я тут делаю, вали отсюда",
        next: "rude"
      }
    ]
  }
];

// Что происходит после выбора (пока заглушка — добавишь свои сцены)
const branches = {
  sleep: "Татьяна Евгеньевна вздыхает: «Смотри у меня. Иди домой.»",
  rude:  "Татьяна Евгеньевна: «Что?! А ну-ка повтори!»"
};

// ====== ЭЛЕМЕНТЫ ======
const dialogueBox = document.getElementById("dialogue-box");
const speakerEl   = document.getElementById("speaker");
const textEl      = document.getElementById("text");
const choicesEl   = document.getElementById("choices");
const gameEl      = document.getElementById("game");

let index = 0;
let state = "line"; // "line" | "choices" | "end"

// ====== РЕНДЕР ======
function render() {
  const node = script[index];

  if (!node) {
    state = "end";
    dialogueBox.classList.add("hidden");
    choicesEl.classList.add("hidden");
    return;
  }

  if (node.type === "line") {
    state = "line";
    choicesEl.classList.add("hidden");
    dialogueBox.classList.remove("hidden");

    speakerEl.textContent = node.speaker ? node.speaker + ":" : "";
    textEl.textContent    = node.text;
  }

  if (node.type === "choices") {
    state = "choices";
    dialogueBox.classList.add("hidden");
    choicesEl.classList.remove("hidden");
    choicesEl.innerHTML = "";

    node.options.forEach(opt => {
      const btn = document.createElement("div");
      btn.className = "choice";
      btn.textContent = opt.text;
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        pickChoice(opt);
      });
      choicesEl.appendChild(btn);
    });
  }
}

// ====== ДЕЙСТВИЯ ======
function advance() {
  if (state !== "line") return;
  index++;
  render();
}

function pickChoice(opt) {
  choicesEl.classList.add("hidden");
  dialogueBox.classList.remove("hidden");
  speakerEl.textContent = "";
  textEl.textContent = branches[opt.next] ?? "(сцена не готова)";
  state = "end";
}

// ====== ВВОД ======
gameEl.addEventListener("click", advance);

window.addEventListener("keydown", (e) => {
  if (e.code === "Space") {
    e.preventDefault();
    advance();
  }
});

// ====== СТАРТ ======
render();
</script>

</body>
</html>
